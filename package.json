{
  "name": "ghg-inventory-system",
  "version": "0.1.0",
  "private": true,
  "description": "AI 溫室氣體盤查系統 - 確定性核心引擎與邊源算報查資料契約",
  "type": "module",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');fs.cpSync('src/registry','dist/src/registry',{recursive:true,filter:s=>!s.endsWith('.ts')})\"",
    "start": "npm run build && node dist/src/server/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest:moenv": "python tools/ingest_moenv_ods.py"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2"
  }
}
